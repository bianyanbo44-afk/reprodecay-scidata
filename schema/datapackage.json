{
  "profile": "data-package",
  "name": "reprodecay-census-v0-2",
  "title": "Version-paired dependency and interface evolution in Python research software",
  "version": "0.2.0",
  "description": "Seven relational CSV tables derived by static analysis of publication and endpoint snapshots for 345 JOSS-associated Python projects.",
  "resources": [
    {
      "name": "project-records",
      "path": "../data/census_v0.2/tables/project_records.csv",
      "profile": "tabular-data-resource",
      "format": "csv",
      "mediatype": "text/csv",
      "encoding": "utf-8-sig",
      "schema": {
        "fields": [
          {"name": "project_id", "type": "string", "constraints": {"required": true, "unique": true, "pattern": "^doi_10_21105_joss_[0-9]{5}$"}},
          {"name": "pair_id", "type": "string", "constraints": {"required": true, "unique": true, "pattern": "^doi_10_21105_joss_[0-9]{5}__[0-9a-f]{12}__[0-9a-f]{12}$"}},
          {"name": "scholarly_doi", "type": "string", "constraints": {"required": true, "unique": true, "pattern": "^10\\.21105/joss\\.[0-9]{5}$"}},
          {"name": "title", "type": "string", "constraints": {"required": true}},
          {"name": "publication_date", "type": "date", "constraints": {"required": true}},
          {"name": "joss_url", "type": "string", "format": "uri", "constraints": {"required": true}},
          {"name": "input_repository_url", "type": "string", "format": "uri", "constraints": {"required": true}},
          {"name": "resolved_repository_url", "type": "string", "format": "uri", "constraints": {"required": true}},
          {"name": "selection_rank", "type": "integer", "constraints": {"required": true, "unique": true, "minimum": 1}},
          {"name": "selected_role", "type": "string", "constraints": {"required": true, "enum": ["census_provisional"]}},
          {"name": "publication_archive_doi", "type": "string", "constraints": {"required": true, "pattern": "^10\\."}},
          {"name": "publication_snapshot_id", "type": "string", "constraints": {"required": true, "unique": true}},
          {"name": "endpoint_snapshot_id", "type": "string", "constraints": {"required": true, "unique": true}},
          {"name": "endpoint_policy", "type": "string", "constraints": {"required": true, "enum": ["latest_stable_release_else_default_branch_head"]}},
          {"name": "endpoint_ref_type", "type": "string", "constraints": {"required": true, "enum": ["release", "default_branch"]}},
          {"name": "endpoint_ref_name", "type": "string", "constraints": {"required": true}},
          {"name": "endpoint_commit_sha", "type": "string", "constraints": {"required": true, "pattern": "^[0-9a-f]{40}$"}},
          {"name": "repository_archived_at_endpoint", "type": "boolean", "constraints": {"required": true}},
          {"name": "repository_license_spdx_at_endpoint", "type": "string"}
        ],
        "primaryKey": "project_id"
      }
    },
    {
      "name": "snapshot-records",
      "path": "../data/census_v0.2/tables/snapshot_records.csv",
      "profile": "tabular-data-resource",
      "format": "csv",
      "mediatype": "text/csv",
      "encoding": "utf-8-sig",
      "schema": {
        "fields": [
          {"name": "snapshot_id", "type": "string", "constraints": {"required": true, "unique": true, "pattern": "^doi_10_21105_joss_[0-9]{5}__(publication|endpoint)__[0-9a-f]{16}$"}},
          {"name": "project_id", "type": "string", "constraints": {"required": true}},
          {"name": "pair_id", "type": "string", "constraints": {"required": true}},
          {"name": "snapshot_role", "type": "string", "constraints": {"required": true, "enum": ["publication", "endpoint"]}},
          {"name": "source_provider", "type": "string", "constraints": {"required": true, "enum": ["zenodo", "figshare", "caltechdata", "github"]}},
          {"name": "source_identifier", "type": "string", "constraints": {"required": true}},
          {"name": "source_ref", "type": "string", "constraints": {"required": true}},
          {"name": "commit_sha", "type": "string", "constraints": {"pattern": "^$|^[0-9a-f]{40}$"}},
          {"name": "source_url", "type": "string", "format": "uri", "constraints": {"required": true}},
          {"name": "archive_bytes", "type": "integer", "constraints": {"required": true, "minimum": 1}},
          {"name": "archive_sha256", "type": "string", "constraints": {"required": true, "pattern": "^[0-9a-f]{64}$"}},
          {"name": "upstream_checksum", "type": "string"},
          {"name": "parser_version", "type": "string", "constraints": {"required": true}},
          {"name": "third_party_code_executed", "type": "boolean", "constraints": {"required": true, "enum": [false]}}
        ],
        "primaryKey": "snapshot_id",
        "foreignKeys": [
          {"fields": "project_id", "reference": {"resource": "project-records", "fields": "project_id"}},
          {"fields": "pair_id", "reference": {"resource": "project-records", "fields": "pair_id"}}
        ]
      }
    },
    {
