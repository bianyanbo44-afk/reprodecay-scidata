          {"name": "ci_workflow_file_count", "type": "integer", "constraints": {"required": true, "minimum": 0}},
          {"name": "ci_providers", "type": "array", "constraints": {"required": true}},
          {"name": "citation_cff", "type": "boolean", "constraints": {"required": true}},
          {"name": "codemeta", "type": "boolean", "constraints": {"required": true}},
          {"name": "zenodo_metadata", "type": "boolean", "constraints": {"required": true}},
          {"name": "contributing", "type": "boolean", "constraints": {"required": true}},
          {"name": "code_of_conduct", "type": "boolean", "constraints": {"required": true}},
          {"name": "security_policy", "type": "boolean", "constraints": {"required": true}},
          {"name": "changelog", "type": "boolean", "constraints": {"required": true}},
          {"name": "dependency_parse_complete", "type": "boolean", "constraints": {"required": true}},
          {"name": "api_parse_complete", "type": "boolean", "constraints": {"required": true}},
          {"name": "parser_issues", "type": "array", "constraints": {"required": true}},
          {"name": "parser_version", "type": "string", "constraints": {"required": true}},
          {"name": "third_party_code_executed", "type": "boolean", "constraints": {"required": true, "enum": [false]}}
        ],
        "primaryKey": "snapshot_id",
        "foreignKeys": [
          {"fields": "snapshot_id", "reference": {"resource": "snapshot-records", "fields": "snapshot_id"}},
          {"fields": "project_id", "reference": {"resource": "project-records", "fields": "project_id"}}
        ]
      }
    },
    {
