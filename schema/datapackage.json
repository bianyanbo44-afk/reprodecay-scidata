          {"name": "archive_sha256", "type": "string", "constraints": {"required": true, "pattern": "^[0-9a-f]{64}$"}},
          {"name": "suspicious_member_count", "type": "integer", "constraints": {"required": true, "minimum": 0}},
          {"name": "link_member_count", "type": "integer", "constraints": {"required": true, "minimum": 0}},
          {"name": "duplicate_normalized_member_count", "type": "integer", "constraints": {"required": true, "minimum": 0}},
          {"name": "skipped_large_text_count", "type": "integer", "constraints": {"required": true, "minimum": 0}},
